# .env.example — established by dz-runner setup mode.
# NAMES only. Copy to `.env`, fill each value there, and never commit that file.

# dormant: only a live `claudetm start` run needs it (an api-key profile injects it at the SDK subprocess boundary); setup (optional)
ANTHROPIC_API_KEY=

# dormant: custom Anthropic-compatible endpoint for an api-key profile; defaults to the Anthropic API (optional)
ANTHROPIC_BASE_URL=

# dormant: read only when creating an api-key profile (`claudetm profile add`); never a CLI flag (optional)
CLAUDETM_API_KEY=

# dormant: password auth for the REST/MCP server; the compose stack starts with it empty (auth disabled) (optional)
CLAUDETM_PASSWORD=

# dormant: HMAC secret for outbound webhook deliveries; unused unless webhooks are registered (optional)
CLAUDETM_WEBHOOK_SECRET=

# dormant: outbound webhook target read by the workflow start command; optional (optional)
CLAUDETM_WEBHOOK_URL=

# dormant: selects the active credential profile; defaults to the ambient ~/.claude login (optional)
CLAUDETM_PROFILE=

# dormant: base branch for PRs; defaults to main (optional)
CLAUDETM_TARGET_BRANCH=

# dormant: REST CORS allowlist; empty by default (optional)
CLAUDETM_CORS_ORIGINS=

# dormant: REST API port; defaults to 8000 (compose maps 8000) (optional)
CLAUDETM_REST_PORT=

# dormant: MCP server port; defaults to 8080 (compose maps 8080) (optional)
CLAUDETM_MCP_PORT=

# dormant: bind address of the unified server; defaults to 127.0.0.1 (optional)
CLAUDETM_SERVER_HOST=

# dormant: MCP transport, sse or streamable-http; defaults to sse (optional)
CLAUDETM_MCP_TRANSPORT=

# dormant: log verbosity for the server; defaults to info (optional)
CLAUDETM_LOG_LEVEL=

# dormant: example deployment template toggle only (optional)
CLAUDETM_AUTO_MERGE=

# dormant: example deployment template cap only (optional)
CLAUDETM_MAX_SESSIONS=

# dormant: example deployment template volume name only (optional)
CLAUDETM_PROFILES_VOLUME=

# dormant: example deployment template — the repo directory mounted into the container (optional)
PROJECT_PATH=

# dormant: example deployment template — reverse-proxy host (optional)
DOMAIN=

# dormant: example deployment template — TLS certificate path (optional)
SSL_CERT_PATH=

# dormant: example deployment template — TLS key path (optional)
SSL_KEY_PATH=

# dormant: example deployment template — monitoring stack user (optional)
GRAFANA_ADMIN_USER=

# dormant: example deployment template — monitoring stack password (optional)
GRAFANA_ADMIN_PASSWORD=

# dormant: the gh CLI needs it for PR and CI operations; the container mounts ~/.config/gh read-only instead (optional)
GITHUB_TOKEN=

# dormant: Sentry access token for the optional user-local sentry-mcp server — see docs/mcp-optional-integrations.md (optional)
SENTRY_ACCESS_TOKEN=

# dormant: Sentry host for the optional user-local sentry-mcp server; defaults to sentry.io (optional)
SENTRY_HOST=

# dormant: developerz.ai API key for the optional user-local developerz MCP server — see docs/mcp-optional-integrations.md (optional)
DEVELOPERZ_API_KEY=

# Services these commands need running:
#   claudetm-server — docker compose up -d — the `claudetm` service in docker-compose.yml (REST :8000, MCP :8080); needs the external volume `
#   github — external — the `gh` CLI (installed by setup) plus a token; the container mounts ~/.config/gh read-only
#   claude-api — external — the Claude Agent SDK reaches Anthropic with the operator's own credential (~/.claude OAuth login or a CLAUDET
