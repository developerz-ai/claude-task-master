#!/usr/bin/env bash
# Pre-commit gate — runs the SAME `bin/check` CI runs, so a commit that would
# fail CI fails here first.
# Installed by: scripts/setup-hooks.sh
#
# The gate decides: the hook neither repairs the tree behind the committer's
# back nor reports success when the gate failed. The gate's exit status
# becomes the hook's, so a red gate blocks the commit.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)" || {
    echo "pre-commit: cannot locate the repository root" >&2
    exit 1
}
cd "$repo_root"
exec "$repo_root/bin/check"
